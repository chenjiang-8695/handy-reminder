+    def is_cjk(self, ch):
+        """这个字符该用中文字体还是拉丁字体。
+
+        原来的判定只看 `assets/zidian_new_5883.txt` 的 5883 字 + 中文标点, 于是语料里
+        表外的常用字(周/早/半/货…)会落到拉丁字体上, 渲染成豆腐块 □ —— 样本直接废掉。
+        这里改成按 Unicode 区段判断, 中文字体才是唯一能画中文的那一支。
+        """
+        code = ord(ch)
+        return (ch in self.hanzi_font_chars
+                or 0x2E80 <= code <= 0x9FFF      # 部首 + CJK 基本区
+                or 0xF900 <= code <= 0xFAFF      # 兼容汉字
+                or 0xFF00 <= code <= 0xFFEF)     # 全角字符/标点
+
